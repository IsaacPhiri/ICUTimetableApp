<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".ProgramsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Program ID (Read-Only) -->
        <EditText
            android:id="@+id/et_program_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/darker_gray"
            android:enabled="false"
            android:hint="Program ID"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- Program Name -->
        <EditText
            android:id="@+id/et_program_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Program Name"
            android:inputType="textPersonName"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- Description -->
        <EditText
            android:id="@+id/et_program_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:lines="3" />

        <!-- Buttons for CRUD Operations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_create_program"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Create"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/btn_update_program"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Update"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/btn_delete_program"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                tools:ignore="ButtonStyle" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- List of Programs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPrograms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
